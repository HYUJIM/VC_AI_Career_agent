# deploy/ai.env: AI(ai 컨테이너)만 읽는 값. 서버에만 두고 커밋하지 않는다(권한 600).
# AI_SERVICE_TOKEN은 docker-compose.yml이 deploy/.env의 값을 넣는다 (여기 넣어도 무시됨).
# 자세한 설명: ai/README.md 6번, deploy/ENV_MATRIX.md

# ── 커리큘럼 LLM (Anthropic Claude API, 기본 공급자). false면 템플릿 학습 계획만 동작 ──
CURRICULUM_LLM_ENABLED=false
# claude(기본, 비워도 같음) | gemini | compatible(OpenAI 호환 HTTPS API). local-transformers는 이 이미지에 GPU 패키지가 없어 못 씀
# CURRICULUM_LLM_PROVIDER=claude
# Claude Console(platform.claude.com) > API keys에서 만든 키. x-api-key 헤더에만 쓰이고 주소·로그에는 나오지 않음.
# 출력 가능한 ASCII, 공백 없음. 실제 사용자에게 열기 전에 조직 키를 쓰고 Anthropic의 상용 약관·데이터 정책을 검토한다.
ANTHROPIC_API_KEY=
# 비우면 claude-sonnet-5-5. 예: claude-haiku-5-5(더 싸고 빠름), claude-opus-5-5(가장 뛰어남)
# CURRICULUM_LLM_MODEL=
# 비우면 low. low | medium | high | xhigh | max: 모델이 답하기 전에 얼마나 생각할지(높일수록 느리고 출력 토큰이 늘어남)
# CURRICULUM_LLM_EFFORT=
# AI 프로세스의 동시 LLM 생성 수 (1~32 정수 하나, 기본 2. 1-32 같은 범위를 넣으면 시작하지 않음)
# CURRICULUM_LLM_MAX_CONCURRENCY=2

# ── 대안: Google Gemini API (CURRICULUM_LLM_PROVIDER=gemini일 때만) ──
# Google AI Studio 키 (https://aistudio.google.com/apikey). 실제 사용자에게 열 때는 유료 등급 키를 쓴다
# (무료 등급은 Google이 입력·출력을 제품 개선에 쓸 수 있음). CURRICULUM_LLM_MODEL은 공용(비우면 gemini-3.5-flash-lite).
# GEMINI_API_KEY=
# CURRICULUM_LLM_THINKING_LEVEL=
# GEMINI_API_VERSION=
