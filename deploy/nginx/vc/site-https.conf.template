# HTTPS 모드: SERVER_NAME(도메인)과 /etc/nginx/tls의 인증서가 있을 때.
# 40-vc-site.sh가 ${SERVER_NAME}만 바꿔 /etc/nginx/conf.d/default.conf로 쓴다.

# 80: 인증서 갱신(certbot --webroot)만 받고 나머지는 HTTPS 도메인으로 보낸다.
server {
    listen 8080 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://${SERVER_NAME}$request_uri;
    }
}

# 443에 도메인이 아닌 이름(IP 등)으로 오면 TLS 연결 자체를 거절한다.
server {
    listen 8443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    include /etc/nginx/vc/tls.conf;
    include /etc/nginx/vc/app.conf;
}
