# deploy/backend.env: BE(backend 컨테이너)만 읽는 값. 서버에만 두고 커밋하지 않는다(권한 600).
# scripts/init-secrets.sh가 이 파일을 복사하고 JWT_SECRET·HOLDER_KEY_ENCRYPTION_KEY를 무작위로 채운다.
# APP_ENV·DB_*·PGSSL*·AI_SERVICE_*는 docker-compose.yml이 정한다 (여기 넣어도 무시됨).
# 변수별 규칙·기본값: deploy/ENV_MATRIX.md. 값을 바꾼 뒤에는 scripts/deploy.sh (또는 docker compose up -d backend).

# ── 인증·암호화 키 (용도마다 다른 값. 같으면 BE가 시작하지 않음) ──
JWT_SECRET=
# ⚠️ 사용자 지갑 키를 암호화하는 키. 바꾸거나 잃어버리면 기존 사용자의 지갑 키를 복호화할 수 없다. 서버 밖에도 안전하게 백업한다.
HOLDER_KEY_ENCRYPTION_KEY=
# (선택) 토큰 수명(분, 1~1440, 기본 1440)
# JWT_EXPIRES_MINUTES=1440

# ── DXWorks (협력사 비공개 값: 팀 내부 채널로 받음) ──
# 비우면 발급·검증·포트폴리오·직무 비교가 503 PROVIDER_NOT_CONFIGURED
DXWORKS_API_HOST=
DXWORKS_API_KEY=
DXWORKS_BADGE_TEMPLATE_ID=
# DXWORKS_TIMEOUT_SECONDS=15

# ── 모의 발급 (FE /issue 화면, 시연용). production 기본값은 꺼짐 ──
MOCK_ISSUER_ENABLED=true
# MOCK_ISSUER_TEMPLATE_IDS=
# MOCK_ISSUER_DAILY_LIMIT=10
# 모든 사용자 합계 24시간 한도 (시연 인원 × 사용자별 한도보다 조금 크게)
# MOCK_ISSUER_GLOBAL_DAILY_LIMIT=200

# ── 소셜 로그인 (도메인과 HTTPS가 준비된 뒤. 제공자마다 ID·시크릿·콜백을 함께 넣음) ──
# 콜백은 FE 주소: https://<SERVER_NAME>/auth/<제공자>/callback. 제공자 콘솔에도 같은 주소를 등록한다.
# 쓰지 않는 제공자는 비워 둔다 (그 버튼만 동작하지 않음).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://career.example.com/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://career.example.com/auth/github/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NAVER_REDIRECT_URI=https://career.example.com/auth/naver/callback

# ── 권한·한도 ──
# 공고·학습자료를 반입하는 연구자 계정 UUID (쉼표 구분). 관리자 계정으로 가입한 뒤 넣는다.
RESEARCHER_USER_IDS=
# 커리큘럼 LLM 모드(외부 Anthropic Claude API)를 쓸 계정. * 이면 로그인한 모든 계정. 비우면 아무도 못 씀
CURRICULUM_LLM_USER_IDS=*
# 계정 하나 / 모든 계정 합계의 24시간 LLM 학습 계획 수 (기본 20 / 200)
# CURRICULUM_LLM_DAILY_LIMIT=20
# CURRICULUM_LLM_GLOBAL_DAILY_LIMIT=200

# (선택) 로그 수준. 운영에서 DEBUG는 쓰지 않는다 (외부 호출 URL이 로그에 남음)
# LOG_LEVEL=INFO
