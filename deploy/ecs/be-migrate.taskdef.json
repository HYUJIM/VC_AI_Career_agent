{
  "family": "vc-be-migrate",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/vc-migrate-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/vc-task-no-aws-access",
  "containerDefinitions": [
    {
      "name": "migrate",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/vc-be:<TAG>",
      "essential": true,
      "command": ["python", "-m", "app.migrate"],
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "DB_HOST", "value": "<RDS_ENDPOINT>" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "vc_career_agent" },
        { "name": "PGSSLMODE", "value": "verify-full" },
        { "name": "DB_APP_ROLE", "value": "vc_app" }
      ],
      "secrets": [
        { "name": "DB_USER", "valueFrom": "<SECRET_ARN_RDS_MASTER>:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "<SECRET_ARN_RDS_MASTER>:password::" }
      ],
      "readonlyRootFilesystem": true,
      "stopTimeout": 30,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vc-be",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "migrate"
        }
      }
    }
  ]
}
