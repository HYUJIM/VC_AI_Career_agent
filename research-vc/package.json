{
  "name": "wallet-core-vc",
  "version": "0.1.0",
  "private": true,
  "description": "검증 이력 지갑 코어 - VC 파트 (파싱/정규화/검증 파이프라인 + Mock 서버)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:keys": "tsx scripts/generate-fixture-keys.ts",
    "generate:fixtures": "tsx scripts/generate-fixtures.ts",
    "setup:fixtures": "npm run generate:keys && npm run generate:fixtures",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^2.0.0",
    "cors": "^2.8.5",
    "did-resolver": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonld": "^8.3.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^9.0.8",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
