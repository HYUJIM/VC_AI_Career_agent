# AI service (uvicorn src.server.app:app). Copy to .env; .env is never committed.

# Shared secret with BE's AI_SERVICE_TOKEN (>= 32 bytes). Generate once, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=
AI_MAX_BODY_BYTES=33554432

# Curriculum LLM. Off by default; template plans need none of this.
# BE still decides which accounts may use it (CURRICULUM_LLM_USER_IDS in BE .env).
CURRICULUM_LLM_ENABLED=false
# compatible = OpenAI-compatible HTTPS API, local-transformers = pinned Qwen on this GPU
CURRICULUM_LLM_PROVIDER=compatible
CURRICULUM_LLM_BASE_URL=
CURRICULUM_LLM_MODEL=
CURRICULUM_LLM_API_KEY=
CURRICULUM_LLM_TOKEN_PARAMETER=max_completion_tokens
# local-transformers only: allow one-time download of the pinned model revision.
CURRICULUM_LOCAL_ALLOW_DOWNLOAD=false
