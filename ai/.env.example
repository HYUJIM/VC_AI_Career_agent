# AI service (uvicorn src.server.app:app). Copy to .env; .env is never committed.

# Shared secret with BE's AI_SERVICE_TOKEN (>= 32 bytes). Generate once, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=
# 요청 본문 상한(바이트, 기본 32 MiB). Content-Length가 없는 청크 전송에도 적용된다.
# 공고·학습자료 묶음을 싣는 경로에만 이 값을 쓰고, 그 밖의 경로(공고 하나·자료 하나·미리보기)는 min(4 MiB, 이 값)이다.
# 비워 두면 기본값을 쓴다. 양의 정수가 아니면(예: 32MiB, 0) 서비스가 시작하지 않는다.
AI_MAX_BODY_BYTES=33554432

# ── Curriculum LLM: Google Gemini API (기본 공급자). Off by default; template plans need none of this. ──
# BE still decides which accounts may use it (CURRICULUM_LLM_USER_IDS in BE .env), and the user must
# tick the consent box in FE. Key: https://aistudio.google.com/apikey (README 6번). Check once with
#   .venv/bin/python scripts/gemini_check.py
CURRICULUM_LLM_ENABLED=false
# gemini (default, also when blank) | compatible (OpenAI-compatible HTTPS API) | local-transformers (pinned Qwen on this GPU)
CURRICULUM_LLM_PROVIDER=gemini
# Gemini API key: only in the x-goog-api-key header, never in URLs or logs. Printable ASCII, no spaces.
GEMINI_API_KEY=
# Blank = gemini-3.5-flash-lite (stable, cheapest/fastest). e.g. gemini-3.1-flash-lite, gemini-3.6-flash
CURRICULUM_LLM_MODEL=
# Blank = the model's default (minimal on Flash-Lite). minimal | low | medium | high
# (minimal is not supported on gemini-3.8-flash / Gemini 4). Higher levels use more of the 4,096 output tokens.
CURRICULUM_LLM_THINKING_LEVEL=
# Blank = v1 (stable Interactions endpoint). v1beta only if v1 is refused.
GEMINI_API_VERSION=
# Concurrent LLM generations per AI process. Blank = 2; otherwise one whole number from 1 to 32 (e.g. 4).
# A range such as 1-32 stops the service. Excess waits 10 s, then BE 503 LLM_BUSY.
CURRICULUM_LLM_MAX_CONCURRENCY=

# ── Alternatives (CURRICULUM_LLM_PROVIDER=compatible / local-transformers) ──
# compatible only: OpenAI-compatible HTTPS endpoint, its key and token parameter (CURRICULUM_LLM_MODEL is shared).
CURRICULUM_LLM_BASE_URL=
CURRICULUM_LLM_API_KEY=
CURRICULUM_LLM_TOKEN_PARAMETER=max_completion_tokens
# local-transformers only: allow one-time download of the pinned model revision.
CURRICULUM_LOCAL_ALLOW_DOWNLOAD=false
