# AI service (uvicorn src.server.app:app). Copy to .env; .env is never committed.

# Shared secret with BE's AI_SERVICE_TOKEN (>= 32 bytes). Generate once, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=
# 요청 본문 상한(바이트, 기본 32 MiB). Content-Length가 없는 청크 전송에도 적용된다.
# 공고·학습자료 묶음을 싣는 경로에만 이 값을 쓰고, 그 밖의 경로(공고 하나·자료 하나·미리보기)는 min(4 MiB, 이 값)이다.
# 비워 두면 기본값을 쓴다. 양의 정수가 아니면(예: 32MiB, 0) 서비스가 시작하지 않는다.
AI_MAX_BODY_BYTES=33554432

# ── Curriculum LLM: Anthropic Claude API (기본 공급자). Off by default; template plans need none of this. ──
# BE still decides which accounts may use it (CURRICULUM_LLM_USER_IDS in BE .env), and the user must
# tick the consent box in FE. Key: Claude Console (platform.claude.com) > API keys (README 6번). Check once with
#   .venv/bin/python scripts/claude_check.py
CURRICULUM_LLM_ENABLED=false
# claude (default, also when blank) | gemini | compatible (OpenAI-compatible HTTPS API) | local-transformers (pinned Qwen on this GPU)
CURRICULUM_LLM_PROVIDER=claude
# Anthropic API key: only in the x-api-key header, never in URLs or logs. Printable ASCII, no spaces.
ANTHROPIC_API_KEY=
# Blank = claude-sonnet-5-5. e.g. claude-haiku-5-5 (cheaper, faster), claude-opus-5-5 (most capable)
CURRICULUM_LLM_MODEL=
# Blank = low. low | medium | high | xhigh | max: how much the model thinks before answering
# (more = slower and more output tokens, still within the 25 s per-call limit).
CURRICULUM_LLM_EFFORT=
# Concurrent LLM generations per AI process. Blank = 2; otherwise one whole number from 1 to 32 (e.g. 4).
# A range such as 1-32 stops the service. Excess waits 10 s, then BE 503 LLM_BUSY.
CURRICULUM_LLM_MAX_CONCURRENCY=

# ── Alternatives (CURRICULUM_LLM_PROVIDER=gemini / compatible / local-transformers) ──
# gemini only: Google Gemini API key (x-goog-api-key header). CURRICULUM_LLM_MODEL is shared
# (blank = gemini-3.5-flash-lite); thinking level minimal|low|medium|high; API version v1 (blank) or v1beta.
# Check once with: .venv/bin/python scripts/gemini_check.py
GEMINI_API_KEY=
CURRICULUM_LLM_THINKING_LEVEL=
GEMINI_API_VERSION=
# compatible only: OpenAI-compatible HTTPS endpoint, its key and token parameter (CURRICULUM_LLM_MODEL is shared).
CURRICULUM_LLM_BASE_URL=
CURRICULUM_LLM_API_KEY=
CURRICULUM_LLM_TOKEN_PARAMETER=max_completion_tokens
# local-transformers only: allow one-time download of the pinned model revision.
CURRICULUM_LOCAL_ALLOW_DOWNLOAD=false
