# 이 파일을 복사해서 .env 로 만들고 필요시 값을 바꾸세요.
#   cp .env.example .env

# Mock 서버 포트
PORT=4000

# 데이터 소스 모드: fixture(로컬 목업) | dxledger(실제 DX Ledger 연동, 논문 이후 구현 예정)
VC_SOURCE_MODE=fixture

# fixture 데이터 루트 경로 (프로젝트 루트 기준 상대경로)
FIXTURES_DIR=./fixtures

# CORS 허용 오리진 (AI/BE 팀 로컬 개발 서버 주소를 콤마로 구분해서 추가)
CORS_ORIGIN=http://localhost:3000,http://localhost:8000

# 로그 레벨: debug | info | warn | error
LOG_LEVEL=info

# --- 아래는 DX Ledger 실연동 시 사용할 자리 (논문 기간에는 미사용) ---
# DX_LEDGER_BASE_URL=
# DX_LEDGER_API_KEY=
