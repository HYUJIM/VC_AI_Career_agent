{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wallet-core.local/schemas/raw/ob3-credential.schema.json",
  "title": "OB3CredentialRaw (간소화 버전, schema 체크 전용)",
  "type": "object",
  "required": ["@context", "id", "type", "issuer", "credentialSubject"],
  "properties": {
    "@context": {},
    "id": { "type": "string" },
    "type": { "type": "array", "items": { "type": "string" }, "contains": { "const": "VerifiableCredential" } },
    "issuer": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "issuanceDate": { "type": "string" },
    "expirationDate": { "type": ["string", "null"] },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "achievement"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "achievement": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "criteria": { "type": "object" },
            "alignment": { "type": "array" }
          }
        }
      }
    },
    "evidence": { "type": "array" },
    "proof": { "type": "object" }
  }
}
