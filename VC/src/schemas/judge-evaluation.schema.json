{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wallet-core.local/schemas/judge-evaluation.schema.json",
  "title": "JudgeEvaluation",
  "type": "object",
  "required": [
    "eval_id",
    "run_id",
    "judge_model",
    "claims",
    "faithfulness_score",
    "hallucination_rate",
    "citation_accuracy",
    "evaluated_at"
  ],
  "properties": {
    "eval_id": { "type": "string" },
    "run_id": { "type": "string" },
    "judge_model": { "type": "string" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_text", "supported", "cited_record_id"],
        "properties": {
          "claim_text": { "type": "string" },
          "supported": { "type": "boolean" },
          "cited_record_id": { "type": ["string", "null"] },
          "citation_correct": { "type": ["boolean", "null"] }
        }
      }
    },
    "faithfulness_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "hallucination_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "citation_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "refusal_correct": { "type": ["boolean", "null"] },
    "human_label": {
      "type": ["object", "null"],
      "properties": {
        "labeler_id": { "type": "string" },
        "verdict": { "type": "string", "enum": ["grounded", "partial", "hallucinated"] },
        "agrees_with_judge": { "type": "boolean" }
      }
    },
    "evaluated_at": { "type": "string", "format": "date-time" }
  }
}
