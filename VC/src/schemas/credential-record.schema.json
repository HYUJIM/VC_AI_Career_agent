{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wallet-core.local/schemas/credential-record.schema.json",
  "title": "CredentialRecord",
  "type": "object",
  "required": [
    "record_id",
    "subject_did",
    "schema_version",
    "normalized_at",
    "source",
    "format",
    "issuer",
    "achievement",
    "verification",
    "raw_hash"
  ],
  "properties": {
    "record_id": { "type": "string", "format": "uuid" },
    "subject_did": { "type": "string", "pattern": "^did:" },
    "schema_version": { "type": "string" },
    "normalized_at": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/Source" },
    "format": { "type": "string", "enum": ["OB2.0", "OB3.0", "VC1.1", "VC2.0"] },
    "issuer": { "$ref": "#/$defs/IssuerProfile" },
    "achievement": { "$ref": "#/$defs/Achievement" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/Evidence" }, "default": [] },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "awarded_date": { "type": ["string", "null"] },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/SkillClaim" }, "default": [] },
    "verification": { "$ref": "#/$defs/VerificationResult" },
    "raw_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "Source": {
      "type": "object",
      "required": ["provider", "external_id", "fetched_at"],
      "properties": {
        "provider": { "type": "string", "enum": ["dx_ledger_wallet", "dx_ledger_badge", "hosted_url", "upload"] },
        "external_id": { "type": "string" },
        "fetched_at": { "type": "string", "format": "date-time" }
      }
    },
    "IssuerProfile": {
      "type": "object",
      "required": ["did", "name", "trust_level"],
      "properties": {
        "did": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "trust_level": { "type": "string", "enum": ["accredited", "known", "unknown"] }
      }
    },
    "Alignment": {
      "type": "object",
      "properties": {
        "framework": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "Achievement": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "criteria_narrative": { "type": "string" },
        "achievement_type": { "type": "string" },
        "image_url": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "alignments": { "type": "array", "items": { "$ref": "#/$defs/Alignment" } }
      }
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "SkillClaim": {
      "type": "object",
      "required": ["skill_id", "label_ko", "taxonomy", "confidence", "mapping_method", "source_record_ids"],
      "properties": {
        "skill_id": { "type": "string" },
        "label_ko": { "type": "string" },
        "label_en": { "type": "string" },
        "taxonomy": {
          "type": "object",
          "required": ["source", "code", "version"],
          "properties": {
            "source": { "type": "string", "enum": ["NCS", "ESCO", "internal"] },
            "code": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "level_basis": { "type": "string", "enum": ["assessed", "completion", "participation", "declared"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "mapping_method": { "type": "string", "enum": ["exact_alignment", "alias_dict", "embedding_knn", "manual"] },
        "source_record_ids": { "type": "array", "items": { "type": "string", "format": "uuid" }, "minItems": 1 }
      }
    },
    "VerificationCheck": {
      "type": "object",
      "required": ["check", "result", "checked_at"],
      "properties": {
        "check": {
          "type": "string",
          "enum": ["schema", "did_resolution", "signature", "issuer_trust", "revocation", "anchor_match", "expiration"]
        },
        "result": { "type": "string", "enum": ["pass", "fail", "warn", "skip"] },
        "detail": { "type": "string" },
        "checked_at": { "type": "string", "format": "date-time" }
      }
    },
    "VerificationResult": {
      "type": "object",
      "required": ["status", "checks", "verified_at", "verifier_version"],
      "properties": {
        "status": { "type": "string", "enum": ["verified", "invalid", "revoked", "expired", "unverifiable", "pending"] },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/VerificationCheck" }, "minItems": 7, "maxItems": 7 },
        "proof": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["VC-JWT", "DataIntegrityProof", "HostedVerification"] },
            "alg": { "type": "string" },
            "verification_method": { "type": "string" }
          }
        },
        "anchor": {
          "type": "object",
          "properties": {
            "chain": { "type": ["string", "null"] },
            "tx_id": { "type": ["string", "null"] },
            "block_no": { "type": ["integer", "null"] },
            "anchored_hash": { "type": ["string", "null"] },
            "computed_hash": { "type": ["string", "null"] },
            "match": { "type": ["boolean", "null"] }
          }
        },
        "verified_at": { "type": "string", "format": "date-time" },
        "verifier_version": { "type": "string" }
      }
    }
  }
}
