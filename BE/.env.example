# ====================================================================
# VC AI Career Agent - BE 환경변수 예시 파일 (.env.example)
# 복사하여 .env 로 이름을 변경한 후 로컬 환경에 맞게 사용하세요.
# ====================================================================

# Database Connection (Docker PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:password@localhost:5432/vc_career_agent?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=vc_career_agent

# KNU BaaS Cloud API 연동 정보 (KNU_BaaS_Starter_20261002/credentials/api-access.env 참고)
BAAS_API_HOST=https://api.dxworks.kr
BAAS_TENANT_CODE=knu
# BAAS_API_KEY=dm_sk_... (필요 시 주입)

# AI Service (OpenAI / Claude API Key - 포트폴리오 생성 및 임베딩용)
# OPENAI_API_KEY=your-openai-api-key-here
