# VC AI Career Agent - BE 환경변수 예시 (cp .env.example .env 후 값을 채운다)
# ⚠️ 이 파일은 공개 저장소에 있다. 실제 비밀값은 .env(로컬)나 운영 서버의 deploy/backend.env·deploy/.env(권한 600)에만 넣는다.
# 변수별 기본값·허용 범위·운영 규칙: BE/README "운영 이미지 · 실행 환경(APP_ENV)", docs/GETTING_STARTED.md "2. 환경 변수 설정", deploy/CHECKLIST.md(운영 배포 체크리스트).
# 운영 서버(NCP, deploy/docker-compose.yml)의 변수 표: deploy/ENV_MATRIX.md

# ── 서버 ──
PORT=3000
# development | production. production은 비밀값·DB·OAuth·CORS 규칙을 어기면 시작하지 않는다.
# 운영 환경변수로 옮길 때는 이 줄을 지우거나 production으로 바꾼다 (이미지 기본값 production을 덮어쓴다).
APP_ENV=development
# (선택) 기본 INFO. 운영에서는 DEBUG를 쓰지 않는다 (외부 호출 URL이 로그에 남는다).
# LOG_LEVEL=INFO
# CORS 허용 출처 (콤마 구분, scheme://host[:port], 끝에 / 없음). 운영에서는 FE 출처로 바꾸거나 같은 출처면 비운다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── DB (로컬 Compose PostgreSQL) ──
# DB_USER·DB_PASSWORD는 로컬 전용 공개 값이다. 운영에는 쓰지 않는다 (운영 값은 deploy/docker-compose.yml과 deploy/.env).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=vc_career_agent
# (선택·운영 DB) 연결 대기(초), TLS 검증, 프로세스당 동시 DB 연결 상한. 운영 compose는 PGSSLMODE·PGSSLROOTCERT를 직접 넣는다
# DB_CONNECT_TIMEOUT=10
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/run/vc-db-tls/ca.crt
# DB_MAX_CONNECTIONS=20
# (선택·운영 마이그레이션 전용, 운영 compose의 migrate 서비스가 넣음) BE 서비스용 DB 계정. 로컬에서는 넣지 않는다.
# DB_APP_ROLE=vc_app

# ── 인증·암호화 키 ──
# 비밀값은 용도마다 따로 만든다 (production에서 두 값이 같으면 시작하지 않는다). 생성 명령은 docs/GETTING_STARTED.md "2. 환경 변수 설정".
# 로그인 토큰 서명 키 (32바이트 이상)
JWT_SECRET=
# 액세스 토큰 수명(분, 1~1440)
JWT_EXPIRES_MINUTES=1440
# (선택·현재 미사용) 내부 서비스용 읽기 전용 키. 비우면 꺼진다.
SERVICE_API_KEY=
# 사용자 지갑 키 암호화 마스터 키 (32바이트 base64). ⚠️ 정한 뒤 바꾸거나 잃어버리면 기존 키를 복호화할 수 없다.
HOLDER_KEY_ENCRYPTION_KEY=

# ── DXWorks (협력사 비공개 값: 팀 내부 채널로 받아 .env에만) ──
# 전달본 API_BASE_URL → DXWORKS_API_HOST(https://), API_KEY → DXWORKS_API_KEY. TENANT_CODE는 쓰지 않는다.
DXWORKS_API_HOST=
DXWORKS_API_KEY=
# 전달본 안내서(START_HERE)의 "OB3 배지" 템플릿 ID
DXWORKS_BADGE_TEMPLATE_ID=
# 호출 제한 시간(초, 1~120)
DXWORKS_TIMEOUT_SECONDS=15
# 신원 VP 검증(type=identity) 사용 여부. 화면이 쓰지 않으므로 false로 둔다.
IDENTITY_VERIFICATION_ENABLED=false

# ── 소셜 로그인 (ID·시크릿은 팀 내부 채널로 받아 .env에만) ──
# 제공자마다 ID·시크릿 중 하나라도 비면 그 로그인만 503. 콜백 주소는 FE 주소이고 제공자 콘솔에 등록한 값과 같아야 한다.
# production에서 켜려면 ID·시크릿을 함께 넣고 콜백 주소를 https://로 명시한다. 설정 방법: BE/README "소셜 로그인".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# 추가 허용 콜백 주소 (콤마 구분, GOOGLE_REDIRECT_URI는 자동 포함)
GOOGLE_ALLOWED_REDIRECT_URIS=
# GitHub: OAuth App의 Client ID와 Client secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback
# 네이버: 애플리케이션의 Client ID와 Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:5173/auth/naver/callback
# 세 제공자 호출 제한 시간(초, 1~120). 없거나 비어 있으면 예전 이름 GOOGLE_OAUTH_TIMEOUT_SECONDS를 읽는다.
OAUTH_TIMEOUT_SECONDS=10

# ── 모의 발급 (FE /issue 화면, 시연·테스트용) ──
# 비우면 development에서 켜지고 production에서 꺼진다.
MOCK_ISSUER_ENABLED=
# 기본 템플릿 외 허용 템플릿 ID (쉼표 구분). 시연·테스트용 템플릿만 넣는다.
MOCK_ISSUER_TEMPLATE_IDS=
# 24시간 발급 한도: 사용자별 / 전체 사용자 합계
MOCK_ISSUER_DAILY_LIMIT=10
MOCK_ISSUER_GLOBAL_DAILY_LIMIT=200

# ── AI 서비스 (../ai, docker compose는 AI_SERVICE_URL을 http://ai:8100으로 바꿔 넣는다) ──
AI_SERVICE_URL=http://127.0.0.1:8100
# BE·AI 공유 비밀 (32바이트 이상). AI를 따로 띄우면 ai/.env에도 같은 값을 넣는다.
AI_SERVICE_TOKEN=
# 루프백이 아닌 http:// AI 주소 허용 여부 (Docker 내부망 등). 그 밖에는 HTTPS를 쓴다.
AI_SERVICE_ALLOW_HTTP=false
# 호출 제한 시간(초, 1~600): 일반 / 생성(LLM 커리큘럼·시장 통계)
AI_TIMEOUT_SECONDS=30
AI_GENERATION_TIMEOUT_SECONDS=90
# 프로세스당 AI 동시 묶음 요청 상한 (사용자 한 명은 그중 2자리·분당 30번까지: 코드에 고정)
AI_MAX_CONCURRENCY=4
# 공고·학습자료 반입 연구자 / 커리큘럼 LLM 모드 사용자 UUID (쉼표 구분). CURRICULUM_LLM_USER_IDS=* 이면 로그인한 모든 계정
# LLM 모드는 계획 옵션을 외부 처리자(Anthropic Claude API)로 보낸다. 키·모델은 BE가 아니라 ai/.env의 ANTHROPIC_API_KEY 등 (ai/README.md 6번)
RESEARCHER_USER_IDS=
CURRICULUM_LLM_USER_IDS=
# 허용된 사용자 한 명의 24시간 LLM 모드 학습 계획 수 (비우면 20, 1 이상). 외부 LLM 비용·한도 보호
CURRICULUM_LLM_DAILY_LIMIT=
# 모든 계정을 합친 24시간 LLM 모드 학습 계획 수 (비우면 200, 1 이상). * 로 열었을 때 계정을 여러 개 만들어도 이 값을 넘지 못한다
CURRICULUM_LLM_GLOBAL_DAILY_LIMIT=
# AI 포트폴리오(Claude가 요약·관련성 문장을 씀)도 CURRICULUM_LLM_USER_IDS로 허용한다. 계정 하나 / 모든 계정 합계의 24시간
# 생성·다시 쓰기 수 (비우면 20 / 200, 1 이상). 다시 쓰기는 같은 행을 고치므로 BE 프로세스 메모리로 센다
PORTFOLIO_LLM_DAILY_LIMIT=
PORTFOLIO_LLM_GLOBAL_DAILY_LIMIT=
