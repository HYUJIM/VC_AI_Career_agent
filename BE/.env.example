# ====================================================================
# VC AI Career Agent - BE 환경변수 예시 파일 (.env.example)
# 복사하여 .env 로 이름을 변경한 후 로컬 환경에 맞게 사용하세요.
# 이 파일의 값은 모두 공개된 예시 값입니다. 실제 비밀값은 .env(로컬)나 Secrets Manager·SSM(운영)에만 넣으세요.
# ====================================================================

PORT=3000

# 실행 환경: development | production (비우면 development, 그 밖의 값이면 서버가 시작하지 않는다)
# - development: JWT_SECRET·HOLDER_KEY_ENCRYPTION_KEY가 비어 있으면 경고만 남기고 임시 값으로 대신한다 (로컬·테스트용).
# - production: 아래 중 하나라도 해당하면 서버가 시작하지 않는다 (오류에는 변수 이름만 나오고 값은 나오지 않는다).
#   · JWT_SECRET이 없거나 32바이트 미만이거나, 이 저장소에 공개된 테스트 값(tests/)이나 "x" 반복 같은 자리표시 값
#   · HOLDER_KEY_ENCRYPTION_KEY가 없거나, 공개된 테스트 키나 0x01 반복 같은 자리표시 키
#   · SERVICE_API_KEY를 넣었는데 32바이트 미만이거나 테스트·자리표시 값 (비우면 그대로 허용)
#   · JWT_SECRET·HOLDER_KEY_ENCRYPTION_KEY·SERVICE_API_KEY·AI_SERVICE_TOKEN·DXWORKS_API_KEY 중 넣은 두 값이 서로 같음
#     (비밀값은 용도마다 따로 만든다. 같은 쌍마다 "JWT_SECRET (not the same value as HOLDER_KEY_ENCRYPTION_KEY)"처럼 두 이름만
#     나오고 앞의 이름이 바꿀 값이다)
#   · DB_HOST·DB_NAME·DB_USER가 비었거나, DB_PASSWORD가 비었거나 아래 로컬 기본값(password)
#   마이그레이션 실행기(python -m app.migrate)도 production이면 같은 DB_PASSWORD 규칙으로 접속을 거부하고 --seed를 거부한다.
# BE Docker 이미지 기본값은 production이고, docker-compose.yml은 로컬 서비스에 development를 넣는다.
# 이 파일을 운영 환경변수로 옮겨 쓸 때는 이 줄을 지우거나 production으로 바꾼다 (development면 이미지 기본값을 덮어쓴다).
APP_ENV=development

# (선택) 로그 수준 (기본 INFO). DEBUG면 외부 호출마다 전체 URL(비공개 DXWorks 호스트 포함)을 남기는 httpx 로그와
# 접속 호스트·응답 헤더를 남기는 httpcore 로그도 나오므로 운영에서는 쓰지 않는다 (그 밖의 값에서는 둘 다 WARNING 이상만 남긴다).
# LOG_LEVEL=INFO

# Database Connection (Docker PostgreSQL + pgvector)
# 앱과 마이그레이션 실행기(python -m app.migrate)는 아래 DB_* 값으로 접속한다. DATABASE_URL은 지금 코드가 읽지 않는다.
# DB_USER·DB_PASSWORD 값은 로컬 Compose DB 전용 공개 값이다 (Compose는 DB·BE·AI 포트를 이 PC(127.0.0.1)에서만 연다).
# 운영(RDS)에는 쓰지 않는다: APP_ENV=production에서는 DB_PASSWORD가 비었거나 password면 시작·접속하지 않는다.
DATABASE_URL=postgresql://postgres:password@localhost:5432/vc_career_agent?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=vc_career_agent
# (선택) DB 연결 대기 시간(초, 기본 10)과 libpq TLS 설정.
# 원격 DB(RDS)는 서버 인증서와 호스트 이름을 확인하는 verify-full과 RDS CA 번들을 쓴다 (require는 인증서를 확인하지 않아
# 가짜 서버를 막지 못한다). BE 이미지에는 CA 번들이 없으므로 운영자가 넣는다 (루트 README "AWS 배포 체크리스트").
# DB_CONNECT_TIMEOUT=10
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/app/certs/rds-global-bundle.pem
# (선택, 운영 마이그레이션 태스크 전용) BE 서비스가 접속하는 별도 DB 계정(마스터 사용자가 아닌 계정, 예: vc_app).
# 주면 python -m app.migrate가 끝날 때마다 먼저 public 테이블·시퀀스의 그 계정 권한을 모두 거둔 뒤 앱 테이블
# SELECT·INSERT·UPDATE·DELETE와 시퀀스 사용 권한만 다시 준다(원장 schema_migrations 제외). 그 계정은 마이그레이션 SQL을 하나라도
# 실행하기 전과 권한을 주기 직전에 검사하고, 없는 역할이거나 특권 계정(그 역할이 속한 역할의 SUPERUSER·CREATEROLE·CREATEDB·
# REPLICATION·BYPASSRLS 속성 포함)이거나, 그 역할이나 그 역할이 속한 역할이 public 스키마·DB에 CREATE 권한이 있거나(PUBLIC에 준
# CREATE 포함) DB·public 스키마나 그 밖의 스키마를 소유하거나, 그 역할들(또는 PUBLIC)이 public 테이블에 TRIGGER·REFERENCES(열
# 단위 포함) 권한이나 원장 schema_migrations에 INSERT·UPDATE·DELETE·TRUNCATE 권한이 있거나, 그 역할들이나 기본 제공 역할
# (pg_database_owner·pg_monitor 등), public 스키마에 CREATE 권한이 있거나 DB·public 스키마를 소유한 다른 역할(마이그레이션 계정
# 제외)이 public 스키마에 객체를 소유하거나, public 테이블의 트리거에 WHEN 조건이 있거나 그 트리거가 임시 스키마나 그 역할들의
# 함수를 부르면 실패한다 (종료 코드 1. 처음 검사에 걸리면 아무것도 적용하지 않는다). 로그에는 걸린 검사, 소속 역할 이름과
# 마이그레이션 계정으로 실행할 GRANT·ALTER ... OWNER·REVOKE·DROP SCHEMA 문이나 소유한 객체·스키마·트리거·외래 키 목록이 나온다.
# PostgreSQL 14 이하에서 만들었거나 업그레이드·복원한 DB는 먼저 마이그레이션 계정으로 REVOKE CREATE ON SCHEMA public FROM PUBLIC;을 실행한다.
# 그다음 루트 README "AWS 배포 체크리스트"의 조회로 다른 역할이 public 스키마에 남긴 객체 등이 없는지 확인한다.
# 로컬 Compose의 migrate 서비스도 이 파일을 읽으므로 로컬에서는 넣지 않는다.
# DB_APP_ROLE=vc_app

# 발급·검증 인프라(DXWorks) 접속 정보
# ⚠️ 협력사에서 받은 비공개 값입니다. 이 예시 파일(공개 저장소)에는 실제 값을 쓰지 말고 .env에만 넣으세요.
#    값은 팀 내부 채널로 전달받습니다.
# DXWORKS_API_HOST는 https:// 주소다. http://는 루프백(localhost·127.0.0.1·[::1], 로컬 테스트 서버)만 허용하고,
# 그 밖의 주소면 DXWorks를 호출하지 않고 503(PROVIDER_NOT_CONFIGURED)을 돌려준다.
# DXWorks 호출은 HTTP_PROXY·HTTPS_PROXY·ALL_PROXY·NO_PROXY·SSL_CERT_FILE 같은 환경변수를 쓰지 않고 리디렉션도 따라가지 않는다.
DXWORKS_API_HOST=
DXWORKS_API_KEY=
# 모의 발급(/api/mock-issuer/issue)에서 templateId를 비웠을 때 쓰는 기본 배지 템플릿 ID
DXWORKS_BADGE_TEMPLATE_ID=
# 호출 타임아웃(초)
DXWORKS_TIMEOUT_SECONDS=15

# 인증 (JWT)
# 토큰 없는 요청은 이 파일의 값과 관계없이 항상 401이다 (토큰 없이 부를 수 있는 API: 회원가입·로그인·/health·공유 링크 조회).
# 예전 AUTH_REQUIRED 설정은 없어졌다. 예전 .env에 AUTH_REQUIRED=false가 남아 있으면 지운다 (남아 있으면 시작 로그에 경고만 남는다).
# JWT_SECRET: 32바이트 이상의 임의 문자열. 서버가 여러 개(ECS 태스크·uvicorn 워커)면 모두 같은 값을 써야 서로의 토큰을 받아들인다.
# 비워두면(APP_ENV=development에서만) 서버 시작 시 임시 키를 만들어 재시작할 때마다 기존 토큰이 무효가 된다.
# APP_ENV=production에서는 비었거나 32바이트 미만이거나 이 저장소의 테스트·자리표시 값이면 서버가 시작하지 않는다.
#   생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 액세스 토큰 수명(분). 1~1440 정수만 받는다 (비우면 1440, 그 밖이면 서버가 시작하지 않는다).
# 로그아웃(POST /api/v1/users/logout)하면 수명과 관계없이 그 계정의 토큰이 모두 바로 무효가 된다.
JWT_EXPIRES_MINUTES=1440
# (선택·현재 미사용) 내부 서비스용 읽기 전용 키. X-Service-Key 헤더로 모든 DID의 careers·evidence를 조회할 수 있다
# (POST /api/v1/verify는 403, 그 밖의 API는 401).
# 저장소의 AI 서비스는 BE를 호출하지 않는다(BE가 AI를 호출). 필요한 서비스가 생기기 전에는 비워 둔다. 비우면 비활성(헤더를 보내면 401).
# APP_ENV=production에서 값을 넣으면 JWT_SECRET처럼 32바이트 이상의 새로 만든 임의 값이어야 하고, JWT_SECRET·HOLDER_KEY_ENCRYPTION_KEY·AI_SERVICE_TOKEN·DXWORKS_API_KEY와도 달라야 한다.
SERVICE_API_KEY=

# 관리형 지갑: 사용자 홀더 개인키를 암호화하는 마스터 키 (32바이트, base64)
# 비우면(APP_ENV=development에서만) 새 가입자에게 홀더 키 없이 임시 DID(did:key:z6MkMock...)를 준다.
# APP_ENV=production에서는 없거나 이 저장소의 테스트 키·자리표시 키(0x01 반복 등)면 서버가 시작하지 않는다.
# 서버가 여러 개면 모두 같은 값을 쓴다.
# ⚠️ 한 번 정하면 바꾸거나 잃어버리지 마세요. 바뀌면 기존 사용자의 홀더 키를 복호화할 수 없습니다.
#   생성 예: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
HOLDER_KEY_ENCRYPTION_KEY=

# CORS 허용 출처 (콤마 구분). FE 개발 서버는 vite 프록시를 쓰므로 보통 그대로 두면 된다.
# 운영에서 FE와 API를 같은 출처(/api 경로를 BE로 전달)로 서비스하면 바꿀 필요가 없다. FE를 다른 출처에서 서비스하면
# 그 출처를 정확히 넣는다 (scheme://host[:port], 끝에 / 없음. 예: https://app.example.com).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 테스트용 모의 발급 API(/api/mock-issuer/issue, FE /issue 화면) 사용 여부 (true | false | 비움).
# 비우면 APP_ENV=development는 켜고 production(Docker 이미지 기본값)은 끈다. 운영에서는 시연용으로 쓸 때만 true를 명시한다
# (production에서 켜면 시작 로그에 경고가 한 줄 남는다). 꺼져 있으면 404(Mock issuer is disabled).
# 켜져 있어도 로그인 토큰이 필요하고, 본인 DID에만, 허용된 템플릿만, 사용자별 24시간 MOCK_ISSUER_DAILY_LIMIT건까지 발급한다.
MOCK_ISSUER_ENABLED=
# (선택) 기본 템플릿(DXWORKS_BADGE_TEMPLATE_ID) 말고 모의 발급에서 templateId로 고를 수 있는 템플릿 ID (쉼표 구분).
# 여기와 DXWORKS_BADGE_TEMPLATE_ID에 없는 templateId는 협력사 API를 부르지 않고 403(Template not allowed)이다.
# 회사 API 키로 로그인 사용자 누구나 받을 수 있게 되므로 시연·테스트용 템플릿만 넣는다 (실제 자격·이수를 뜻하는 템플릿 금지).
MOCK_ISSUER_TEMPLATE_IDS=
# 사용자별 최근 24시간 모의 발급 한도 (1 이상 정수, 비우면 10). 넘으면 429. 실패한 발급은 세지 않는다
# (그 기록을 지우는 DB 작업까지 실패한 경우만 한도에 남는다).
MOCK_ISSUER_DAILY_LIMIT=10

# AI 서비스 (../ai, 직무 비교·커리큘럼 계산)
# 로컬 실행 시 기본 주소는 http://127.0.0.1:8100. docker compose는 http://ai:8100으로 자동 설정한다.
AI_SERVICE_URL=http://127.0.0.1:8100
# AI와 공유하는 32바이트 이상 비밀. compose는 이 값을 AI 컨테이너에도 넣는다.
# 로컬에서 AI를 따로 띄우면 ai/.env의 AI_SERVICE_TOKEN도 같은 값으로 맞춘다.
# JWT_SECRET·HOLDER_KEY_ENCRYPTION_KEY·SERVICE_API_KEY·DXWORKS_API_KEY와는 다른 값으로 따로 만든다 (APP_ENV=production에서 같으면 BE가 시작하지 않는다).
#   생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=
# 루프백이 아닌 http:// AI 주소 허용 여부 (Docker 내부망, TLS를 켠 ECS Service Connect 등). 그 외에는 HTTPS를 쓴다.
AI_SERVICE_ALLOW_HTTP=false
AI_TIMEOUT_SECONDS=30
AI_GENERATION_TIMEOUT_SECONDS=90
# 공고·학습자료를 반입할 수 있는 연구자 사용자 UUID (쉼표 구분)
RESEARCHER_USER_IDS=
# 커리큘럼 LLM 모드를 쓸 수 있는 사용자 UUID (쉼표 구분). LLM 키·모델은 ai/.env에 둔다.
CURRICULUM_LLM_USER_IDS=
