# ====================================================================
# VC AI Career Agent - BE 환경변수 예시 파일 (.env.example)
# 복사하여 .env 로 이름을 변경한 후 로컬 환경에 맞게 사용하세요.
# 이 파일의 값은 모두 공개된 예시 값입니다. 실제 비밀값은 .env(로컬)나 Secrets Manager·SSM(운영)에만 넣으세요.
# ====================================================================

PORT=3000

# 실행 환경: development | production (비우면 development, 그 밖의 값이면 서버가 시작하지 않는다)
# - development: JWT_SECRET·HOLDER_KEY_ENCRYPTION_KEY가 비어 있으면 경고만 남기고 임시 값으로 대신한다 (로컬·테스트용).
# - production: 아래 중 하나라도 해당하면 서버가 시작하지 않는다 (오류에는 변수 이름만 나오고 값은 나오지 않는다).
#   · JWT_SECRET이 없거나 32바이트 미만이거나, 이 저장소에 공개된 테스트 값(tests/)이나 "x" 반복 같은 자리표시 값
#   · HOLDER_KEY_ENCRYPTION_KEY가 없거나, 공개된 테스트 키나 0x01 반복 같은 자리표시 키
#   · SERVICE_API_KEY를 넣었는데 32바이트 미만이거나 테스트·자리표시 값 (비우면 그대로 허용)
#   · JWT_SECRET·HOLDER_KEY_ENCRYPTION_KEY·SERVICE_API_KEY·AI_SERVICE_TOKEN·DXWORKS_API_KEY·GOOGLE_CLIENT_SECRET 중 넣은
#     두 값이 서로 같음 (비밀값은 용도마다 따로 만든다. 같은 쌍마다 "JWT_SECRET (not the same value as
#     HOLDER_KEY_ENCRYPTION_KEY)"처럼 두 이름만 나오고 앞의 이름이 바꿀 값이다)
#   · DB_HOST·DB_NAME·DB_USER가 비었거나, DB_PASSWORD가 비었거나 아래 로컬 기본값(password)
#   · GOOGLE_CLIENT_ID·GOOGLE_CLIENT_SECRET 중 하나만 넣었거나, 둘을 넣었는데 GOOGLE_REDIRECT_URI가 비었거나, 허용하는 콜백
#     주소(GOOGLE_REDIRECT_URI·GOOGLE_ALLOWED_REDIRECT_URIS) 중에 https://가 아닌 것이 있음
#   · CORS_ORIGINS에 `*`·`null`이나 경로·끝의 `/`가 붙은 항목이 있음 (scheme://host[:port]만 받는다)
#   production에서는 API 문서(/docs·/redoc·/openapi.json)를 만들지 않고, BE 단독 테스트용 GET 콜백
#   (GET /api/v1/users/oauth/google/callback)은 404다.
#   마이그레이션 실행기(python -m app.migrate)도 production이면 같은 DB_PASSWORD 규칙으로 접속을 거부하고 --seed를 거부한다.
# BE Docker 이미지 기본값은 production이고, docker-compose.yml은 로컬 서비스에 development를 넣는다.
# 이 파일을 운영 환경변수로 옮겨 쓸 때는 이 줄을 지우거나 production으로 바꾼다 (development면 이미지 기본값을 덮어쓴다).
APP_ENV=development

# (선택) 로그 수준 (기본 INFO). DEBUG면 외부 호출마다 전체 URL(비공개 DXWorks 호스트 포함)을 남기는 httpx 로그와
# 접속 호스트·응답 헤더를 남기는 httpcore 로그도 나오므로 운영에서는 쓰지 않는다 (그 밖의 값에서는 둘 다 WARNING 이상만 남긴다).
# 서버·마이그레이션 실행기·시장 통계 배치(python -m app.jobs.market)가 같은 값을 따르고, 비워 두면 INFO다.
# 없는 수준 이름(예: verbose)이면 서버·마이그레이션 실행기는 traceback을 남기며 시작하지 못하고, 시장 통계 배치는 오류 한 줄과
# 종료 코드 2로 끝난다.
# LOG_LEVEL=INFO

# Database Connection (Docker PostgreSQL 16)
# 앱과 마이그레이션 실행기(python -m app.migrate)·시장 통계 배치(python -m app.jobs.market)는 아래 DB_* 값으로 접속한다.
# DB_PORT를 비워 두면 5432다.
# DB_USER·DB_PASSWORD 값은 로컬 Compose DB 전용 공개 값이다 (Compose는 DB·BE·AI 포트를 이 PC(127.0.0.1)에서만 연다).
# 운영(RDS)에는 쓰지 않는다: APP_ENV=production에서는 DB_PASSWORD가 비었거나 password면 시작·접속하지 않는다.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=vc_career_agent
# (선택) DB 연결 대기 시간(초, 기본 10)과 libpq TLS 설정.
# 원격 DB(RDS)는 서버 인증서와 호스트 이름을 확인하는 verify-full과 RDS CA 번들을 쓴다 (require는 인증서를 확인하지 않아
# 가짜 서버를 막지 못한다). BE 이미지에는 CA 번들이 없으므로 운영자가 넣는다 (루트 README "AWS 배포 체크리스트").
# DB_CONNECT_TIMEOUT=10
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/app/certs/rds-global-bundle.pem
# (선택) BE 프로세스(ECS 태스크) 하나가 동시에 여는 DB 연결 수의 상한 (기본 20, 2 이상). 연결 풀은 아니고(호출마다 새 연결을
# 열고 닫는다) 동시에 열린 수만 묶는다. 요청이 몰리면 자리가 날 때까지 5초 기다린 뒤 503 + Retry-After
# (detail "Service is busy. Try again later.")로 답한다. RDS max_connections는 태스크 수 × 이 값에 마이그레이션 태스크와
# 운영자 접속 몫을 더한 것보다 크게 잡는다.
# 앱 세션에는 문장 15초·잠금 대기 5초·트랜잭션을 연 채 쉬는 세션 30초 제한이 걸리고(문장·잠금 제한에 걸린 요청도 같은 503),
# 마이그레이션 실행기(python -m app.migrate)는 이 상한과 시간 제한을 받지 않는다.
# DB_MAX_CONNECTIONS=20
# DB 확장은 필요 없다: 기본 스키마는 pgcrypto·vector를 만들지 않으므로 마이그레이션 계정에 확장을 만들 권한이 없어도 된다
# (예전 버전이 만든 확장이 있는 DB에서는 그대로 둔다).
# (선택, 운영 마이그레이션 태스크 전용) BE 서비스가 접속하는 별도 DB 계정(마스터 사용자가 아닌 계정, 예: vc_app).
# 주면 python -m app.migrate가 끝날 때마다 먼저 public 테이블·시퀀스의 그 계정 권한을 모두 거둔 뒤 앱 테이블
# SELECT·INSERT·UPDATE·DELETE와 시퀀스 사용 권한만 다시 준다(원장 schema_migrations 제외). 그 계정은 마이그레이션 SQL을 하나라도
# 실행하기 전과 권한을 주기 직전에 검사하고, 없는 역할이거나 특권 계정(그 역할이 속한 역할의 SUPERUSER·CREATEROLE·CREATEDB·
# REPLICATION·BYPASSRLS 속성 포함)이거나, 그 역할이나 그 역할이 속한 역할이 public 스키마·DB에 CREATE 권한이 있거나(PUBLIC에 준
# CREATE 포함) DB·public 스키마나 그 밖의 스키마를 소유하거나, 그 역할들(또는 PUBLIC)이 public 테이블에 TRIGGER·REFERENCES(열
# 단위 포함) 권한이나 원장 schema_migrations에 INSERT·UPDATE·DELETE·TRUNCATE 권한이 있거나, 그 역할들이나 기본 제공 역할
# (pg_database_owner·pg_monitor 등), public 스키마에 CREATE 권한이 있거나 DB·public 스키마를 소유한 다른 역할(마이그레이션 계정
# 제외)이 public 스키마에 객체를 소유하거나, public 테이블의 트리거에 WHEN 조건이 있거나 그 트리거가 임시 스키마나 그 역할들의
# 함수를 부르면 실패한다 (종료 코드 1. 처음 검사에 걸리면 아무것도 적용하지 않는다). 로그에는 걸린 검사, 소속 역할 이름과
# 마이그레이션 계정으로 실행할 GRANT·ALTER ... OWNER·REVOKE·DROP SCHEMA 문이나 소유한 객체·스키마·트리거·외래 키 목록이 나온다.
# PostgreSQL 14 이하에서 만들었거나 업그레이드·복원한 DB는 먼저 마이그레이션 계정으로 REVOKE CREATE ON SCHEMA public FROM PUBLIC;을 실행한다.
# 그다음 루트 README "AWS 배포 체크리스트"의 조회로 다른 역할이 public 스키마에 남긴 객체 등이 없는지 확인한다.
# 로컬 Compose의 migrate 서비스도 이 파일을 읽으므로 로컬에서는 넣지 않는다.
# DB_APP_ROLE=vc_app

# 발급·검증 인프라(DXWorks) 접속 정보
# ⚠️ 협력사에서 받은 비공개 값입니다. 이 예시 파일(공개 저장소)에는 실제 값을 쓰지 말고 .env에만 넣으세요.
#    값은 팀 내부 채널로 전달받습니다.
# 협력사 전달본의 이름과 대응: API_BASE_URL → DXWORKS_API_HOST, API_KEY → DXWORKS_API_KEY.
#    DXWORKS_BADGE_TEMPLATE_ID는 전달본 안내서(START_HERE)에 있는 준비된 "OB3 배지" 템플릿 ID(BADGE 분류)다.
#    TENANT_CODE는 BE가 쓰지 않는다 (템플릿 ID 자리에 넣으면 발급이 400 "BADGE template not found"로 실패한다).
# DXWORKS_API_HOST는 https:// 주소다. http://는 루프백(localhost·127.0.0.1·[::1], 로컬 테스트 서버)만 허용한다.
# 비워 두면 서버는 뜨고 DXWorks를 쓰는 기능만 503(PROVIDER_NOT_CONFIGURED)이다. 값을 넣었는데 위 규칙에 맞지 않거나
# 사용자 정보(user:pw@)·쿼리(?)·프래그먼트(#)·공백이 들어 있거나 포트가 1~65535 밖이면 서버가 시작하지 않는다
# (오류에는 변수 이름만 나온다).
# DXWORKS_API_KEY는 ASCII 문자만 쓸 수 있다 (아니면 서버가 시작하지 않는다). 비워 두면 발급·신원 검증만 503이다.
# DXWorks 호출은 HTTP_PROXY·HTTPS_PROXY·ALL_PROXY·NO_PROXY·SSL_CERT_FILE 같은 환경변수를 쓰지 않고 리디렉션도 따라가지 않는다.
DXWORKS_API_HOST=
DXWORKS_API_KEY=
# 모의 발급(/api/mock-issuer/issue)에서 templateId를 비웠을 때 쓰는 기본 배지 템플릿 ID
DXWORKS_BADGE_TEMPLATE_ID=
# 호출 타임아웃(초). 1~120 사이의 숫자만 받는다 (비우면 15, 그 밖이면 서버가 시작하지 않는다).
# 연결·읽기 한 번마다 이 시간을 넘으면 끊는다. 교환(연결·전송·본문 수신) 전체는 이 값의 2배를 넘지 못하고, 연결 자체가 안 된
# 경우의 재시도 한 번도 그 2배 안에서 한다 (남은 시간에 시도 한 번이 온전히 들어갈 때만 다시 한다). 그 전에 동시 호출 자리를
# 기다리는 시간도 이 값의 2배까지라, 호출 한 번은 최악의 경우 4배까지 걸린다 (15면 60초).
DXWORKS_TIMEOUT_SECONDS=15
# DXWorks 호출 보호 (설정값이 아니라 코드에 고정된 한도. 서버 프로세스(ECS 태스크)마다 따로 센다):
# - 로그인 사용자·서비스 키가 검증기를 부르는 API(/verify·재검증·근거 조회·포트폴리오 생성·직무 비교)는 호출자마다 분당 120번과
#   시간당 1,200번, 프로세스 전체로 분당 600번까지. 하나라도 모자라면 DXWorks를 부르지 않고 429 + Retry-After
#   (Retry-After는 모자란 몫이 다시 찰 때까지의 시간 중 가장 긴 값).
# - 배지 검증(POST /api/v1/verify)은 DXWorks까지 가서 그 토큰이 거절된 요청을 호출자마다 10분에 10번까지만 받는다 (넘으면 같은 429).
#   세는 것: 저장하지 않는 success: false, 다른 DID에 발급된 배지(403), 다른 사용자가 등록한 배지(409), 그 토큰 하나에 대한 검증기
#   오류(502), DXWorks에 묻는 동안 끊긴 요청. 통과한 검증, 폐기·만료 상태로 저장된 배지, 검증기 장애, DXWorks가 답한 뒤 서버 쪽
#   문제(DB가 바빠 503 등)로 끝난 요청은 세지 않는다.
#   토큰이 JWT 모양(compact JWS. 조각 끝의 = 패딩과 SD-JWT 형식은 받는다)이 아니면 DXWorks로 보내지 않는다.
# - 로그인 없는 공유 링크 조회는 프로세스마다 분당 300번까지 (같은 서명 원본은 60초 동안 다시 묻지 않음). 모자라면 503 + Retry-After.
# - 동시에 보내는 요청은 프로세스마다 16개까지, 응답 본문은 1 MiB까지만 받는다. 압축 응답은 요청하지 않으며, 그래도 gzip·deflate로
#   온 응답은 전송된 크기와 풀어낸 크기를 각각 1 MiB까지만 받으며 직접 풀고 그 밖의 압축 방식(br·zstd·겹친 압축)은 받지 않는다.
# - 로거 vc-be.audit에 INFO 한 줄씩 남는다: 검증기를 부른 요청(event=verifier_calls), 한도로 거절한 요청
#   (event=verifier_budget_denied. 토큰이 거절된 배지 검증의 10분 한도는 route=verify_rejected), 모양 검사로 DXWorks에 보내지 않은
#   배지 토큰(event=verify_shape_refused).
# (선택) 신원 VP 검증(POST /api/v1/verify의 type=identity) 사용 여부 (true | false, 비우면 false).
# 이 제품의 화면은 쓰지 않고, 사용자가 보낸 값에 회사 API 키를 붙여 DXWorks로 보내는 호출이라 기본은 끈다 (꺼져 있으면 400).
IDENTITY_VERIFICATION_ENABLED=false

# 인증 (JWT)
# 토큰 없는 요청은 이 파일의 값과 관계없이 항상 401이다 (토큰 없이 부를 수 있는 API: 회원가입·로그인·Google 로그인·/health·
# 공유 링크 조회). 같은 이메일로 15분 안에 10번 로그인에 실패하면 그 이메일은 429가 되고, 잠긴 뒤의 시도마다 로거
# vc-be.audit에 INFO 한 줄이 남는다 (event=login_locked key=<이메일 SHA-256의 앞 12자리> retry_after=<초>. 이메일 원문 없음).
# DB가 바빠 503(Service is busy. Try again later.)으로 답한 로그인 시도는 실패로 세지 않는다 (비밀번호를 확인한 적이 없다).
# 예전 AUTH_REQUIRED 설정은 없어졌다. 예전 .env에 AUTH_REQUIRED=false가 남아 있으면 지운다 (남아 있으면 시작 로그에 경고만 남는다).
# JWT_SECRET: 32바이트 이상의 임의 문자열. 서버가 여러 개(ECS 태스크·uvicorn 워커)면 모두 같은 값을 써야 서로의 토큰을 받아들인다.
# 비워두면(APP_ENV=development에서만) 서버 시작 시 임시 키를 만들어 재시작할 때마다 기존 토큰이 무효가 된다.
# APP_ENV=production에서는 비었거나 32바이트 미만이거나 이 저장소의 테스트·자리표시 값이면 서버가 시작하지 않는다.
#   생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 액세스 토큰 수명(분). 1~1440 정수만 받는다 (비우면 1440, 그 밖이면 서버가 시작하지 않는다).
# 로그아웃(POST /api/v1/users/logout)하면 수명과 관계없이 그 계정의 토큰이 모두 바로 무효가 된다.
JWT_EXPIRES_MINUTES=1440
# (선택·현재 미사용) 내부 서비스용 읽기 전용 키. X-Service-Key 헤더로 모든 DID의 careers·evidence를 조회할 수 있다
# (POST /api/v1/verify는 403, 그 밖의 API는 401).
# 저장소의 AI 서비스는 BE를 호출하지 않는다(BE가 AI를 호출). 필요한 서비스가 생기기 전에는 비워 둔다. 비우면 비활성(헤더를 보내면 401).
# APP_ENV=production에서 값을 넣으면 JWT_SECRET처럼 32바이트 이상의 새로 만든 임의 값이어야 하고, JWT_SECRET·HOLDER_KEY_ENCRYPTION_KEY·AI_SERVICE_TOKEN·DXWORKS_API_KEY·GOOGLE_CLIENT_SECRET과도 달라야 한다.
SERVICE_API_KEY=

# 관리형 지갑: 사용자 홀더 개인키를 암호화하는 마스터 키 (32바이트, base64)
# 비우면(APP_ENV=development에서만) 새 가입자에게 홀더 키 없이 임시 DID(did:key:z6MkMock...)를 준다.
# APP_ENV=production에서는 없거나 이 저장소의 테스트 키·자리표시 키(0x01 반복 등)면 서버가 시작하지 않는다.
# 서버가 여러 개면 모두 같은 값을 쓴다.
# ⚠️ 한 번 정하면 바꾸거나 잃어버리지 마세요. 바뀌면 기존 사용자의 홀더 키를 복호화할 수 없습니다.
#   생성 예: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
HOLDER_KEY_ENCRYPTION_KEY=

# Google OAuth 2.0 / OIDC 소셜 로그인
# GOOGLE_CLIENT_ID 또는 GOOGLE_CLIENT_SECRET이 비어 있으면 /api/v1/users/oauth/google/* 는 503
# (`Google OAuth is not configured`)을 반환합니다. Google 쪽 실패는 502 `Google OAuth error`입니다.
# APP_ENV=production에서 Google 로그인을 켜려면 ID와 시크릿을 함께 넣고, GOOGLE_REDIRECT_URI에 FE의 https 콜백 주소
# (예: https://app.example.com/auth/google/callback)를 명시한다. 하나라도 어기면 서버가 시작하지 않는다 (맨 위 APP_ENV 설명).
# GOOGLE_CLIENT_SECRET은 Google로 보내는 값이므로 JWT_SECRET 등 다른 비밀값과 같은 값을 쓰지 않는다.
# 계정 연동 규칙: 같은 이메일의 기존 계정에 비밀번호가 있으면 Google 로그인을 그 계정에 붙이지 않고 409로 답한다
# (가입은 이메일 소유를 확인하지 않으므로, 남의 주소로 먼저 가입해 둔 계정에 진짜 주인을 넣지 않기 위해서다).
# Google 호출은 HTTP_PROXY·HTTPS_PROXY·ALL_PROXY·NO_PROXY·SSL_CERT_FILE 같은 환경변수를 쓰지 않고 리디렉션도 따라가지 않는다.
# 토큰 교환(콜백)은 서버 프로세스(ECS 태스크)마다 분당 300번까지다 (코드에 고정). 넘으면 Google을 부르지 않고 429 + Retry-After이고,
# 거절한 콜백마다 로거 vc-be.audit에 INFO 한 줄이 남는다 (event=oauth_exchange_denied retry_after=<초>).
# 로그인 결과마다 로거 vc-be.audit에 INFO 한 줄이 남는다
# (event=oauth_login outcome=created|linked|login|refused_password_account user=<사용자 UUID>. 이메일·이름 없음).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 기본 콜백 주소. 지우면(변수 자체가 없으면) development만 이 로컬 주소를 대신 쓰고, production은 대신하지 않는다.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# 추가 허용 콜백 URI가 필요할 때만 콤마로 구분해 입력 (GOOGLE_REDIRECT_URI는 자동 포함)
GOOGLE_ALLOWED_REDIRECT_URIS=
# Google 호출 타임아웃(초). 1~120 사이의 숫자만 받는다 (비우면 10, 그 밖이면 서버가 시작하지 않는다).
GOOGLE_OAUTH_TIMEOUT_SECONDS=10

# CORS 허용 출처 (콤마 구분). FE 개발 서버는 vite 프록시를 쓰므로 보통 그대로 두면 된다.
# 운영에서 FE와 API를 같은 출처(/api 경로를 BE로 전달)로 서비스하면 비워 둔다. FE를 다른 출처에서 서비스하면
# 그 출처를 정확히 넣는다 (scheme://host[:port], 끝에 / 없음. 예: https://app.example.com).
# 변수가 없으면 development는 아래 로컬 주소를 쓴다 (빈 값으로 두면 빈 목록). production은 변수가 없거나 비어 있으면
# 다른 출처를 허용하지 않는다(빈 목록).
# production에서 `*`·`null`이나 경로·끝의 `/`가 붙은 항목을 넣으면 서버가 시작하지 않는다.
# 이 파일을 운영 환경변수로 옮길 때는 아래 로컬 주소를 지우거나 FE 출처로 바꾼다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 테스트용 모의 발급 API(/api/mock-issuer/issue, FE /issue 화면) 사용 여부 (true | false | 비움).
# 비우면 APP_ENV=development는 켜고 production(Docker 이미지 기본값)은 끈다. 운영에서는 시연용으로 쓸 때만 true를 명시한다
# (production에서 켜면 시작 로그에 경고가 한 줄 남는다). 꺼져 있으면 404(Mock issuer is disabled).
# 켜져 있어도 로그인 토큰이 필요하고, 본인 DID에만, 허용된 템플릿만, 사용자별 24시간 MOCK_ISSUER_DAILY_LIMIT건·전체 24시간
# MOCK_ISSUER_GLOBAL_DAILY_LIMIT건까지 발급한다.
MOCK_ISSUER_ENABLED=
# (선택) 기본 템플릿(DXWORKS_BADGE_TEMPLATE_ID) 말고 모의 발급에서 templateId로 고를 수 있는 템플릿 ID (쉼표 구분).
# 여기와 DXWORKS_BADGE_TEMPLATE_ID에 없는 templateId는 협력사 API를 부르지 않고 403(Template not allowed)이다.
# 회사 API 키로 로그인 사용자 누구나 받을 수 있게 되므로 시연·테스트용 템플릿만 넣는다 (실제 자격·이수를 뜻하는 템플릿 금지).
MOCK_ISSUER_TEMPLATE_IDS=
# 사용자별 최근 24시간 모의 발급 한도 (1 이상 정수, 비우면 10). 넘으면 429 (detail "Mock issuance limit reached; try again later").
# 협력사가 거절·실패로 답했거나 요청이 닿지 않은 발급은 세지 않는다 (그 기록을 지우는 DB 작업까지 실패한 경우만 한도에 남는다).
# 요청이 협력사에 닿았을 수 있는데 결과를 모르는 실패(응답 대기 중 시간 초과, jwt 없는 2xx 응답)는 배지가 이미 발급됐을 수 있으므로
# 한도에 센다 (이 사용자별 한도에는 24시간 동안. 아래 전체 한도에는 10분 동안만).
# 이와 별도로 협력사 호출을 시도한 요청은 실패해도(연결 실패 포함) 사용자별 24시간 max(30, 3 × 이 값)번까지만 받는다
# (프로세스마다 메모리에서 셈. 넘으면 같은 429. 성공한 발급도 시도로 세므로 이 값을 30보다 크게 올려도 가려지지 않게 3배로 둔다).
MOCK_ISSUER_DAILY_LIMIT=10
# 모든 사용자를 합친 최근 24시간 모의 발급 한도 (1 이상 정수, 비우면 200). 넘으면 누구에게나 429이고, 사용자 자신의 한도와
# 구분되게 detail이 다르다 ("Mock issuance service limit reached; try again later." FE는 '전체 모의 발급 한도' 안내를 보여 준다).
# 가입은 누구나 할 수 있으므로, 계정을 여러 개 만들어 사용자별 한도를 곱하지 못하게 회사 API 키 사용량 전체를 묶는다.
# 기본 200은 20명이 10건씩 받으면 차므로 시연 인원 × 사용자별 한도에 맞춰 잡는다.
# 세는 것: 최근 24시간의 성공한 발급과, 상태와 관계없이 최근 10분(진행 중 창: 발급 요청 하나가 걸릴 수 있는 가장 긴 시간보다 길다)
# 안에 만든 기록(협력사를 부르는 중인 요청, 결과를 모르는 실패). 그래서 응답 대기 시간 초과로 이어진 장애가 이 한도를 채워도
# 24시간 동안 막히지 않고, 협력사가 돌아온 뒤 길어야 10분에 1분쯤 더 지나면 다시 발급된다.
# 위의 전체 한도 문구는 DB로 세는 이 발급 한도에 닿았을 때와, 아래 실패 차단기가 진행 중인 요청만으로 찼을 때
# (실패한 것 없이 이 값만큼의 요청이 한꺼번에 진행 중. Retry-After 없음) 나온다.
# 같은 값을 태스크 전체의 실패 차단기에도 쓴다: 협력사 호출을 시도했는데 성공하지 못한 발급(거절·5xx·연결 실패·결과를 모르는 실패)이
# 모든 사용자를 합쳐 프로세스마다 24시간에 이 값만큼 쌓이면(진행 중인 요청의 자리도 함께 세고, 실패로 끝난 발급이 하나라도 있을 때만)
# 발급을 멈추고 60초에 한 건만 협력사로 보내 본다. 그 밖의 요청은 협력사를 부르지 않고 429 + Retry-After다
# (detail "Mock issuance is paused after repeated failures. Try again shortly."). 보내 본 한 건이 성공하면 실패 기록을 모두 지워
# 바로 다시 연다 (재시작하거나 24시간을 기다리지 않는다).
MOCK_ISSUER_GLOBAL_DAILY_LIMIT=200

# AI 서비스 (../ai, 직무 비교·커리큘럼 계산)
# 로컬 실행 시 기본 주소는 http://127.0.0.1:8100. docker compose는 http://ai:8100으로 자동 설정한다.
AI_SERVICE_URL=http://127.0.0.1:8100
# AI와 공유하는 32바이트 이상 비밀. compose는 이 값을 AI 컨테이너에도 넣는다.
# 로컬에서 AI를 따로 띄우면 ai/.env의 AI_SERVICE_TOKEN도 같은 값으로 맞춘다.
# JWT_SECRET·HOLDER_KEY_ENCRYPTION_KEY·SERVICE_API_KEY·DXWORKS_API_KEY·GOOGLE_CLIENT_SECRET과는 다른 값으로 따로 만든다 (APP_ENV=production에서 같으면 BE가 시작하지 않는다).
#   생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=
# 루프백이 아닌 http:// AI 주소 허용 여부 (Docker 내부망, TLS를 켠 ECS Service Connect 등). 그 외에는 HTTPS를 쓴다.
AI_SERVICE_ALLOW_HTTP=false
# AI 호출 타임아웃(초): 일반 호출과 생성 호출(LLM 커리큘럼·시장 통계 계산). 각각 1~600 사이의 숫자만 받는다
# (비우면 30·90, 그 밖이면 서버가 시작하지 않는다).
AI_TIMEOUT_SECONDS=30
AI_GENERATION_TIMEOUT_SECONDS=90
# (선택) BE 프로세스 하나가 AI 서비스에 동시에 보내는 공고·학습자료 묶음 요청(공고 검색·직무 비교·학습자료 검색·커리큘럼 계획) 수의
# 상한 (기본 4, 1 이상). 넘는 요청은 자리가 날 때까지 10초 기다린 뒤 AI를 부르지 않고 503(code AI_SERVICE_BUSY) + Retry-After로 답한다.
# 직무 비교는 자격증명 재검증(DXWorks)을 마친 뒤에 자리를 잡는다: 이 503으로 끝난 직무 비교도 그 요청의 DXWorks 호출은 이미 쓴 뒤다.
AI_MAX_CONCURRENCY=4
# 공고·학습자료를 반입할 수 있는 연구자 사용자 UUID (쉼표 구분). 여기에 없는 계정이 반입·미리보기 API를 부르면 본문 형식을
# 검사하기 전에 403이다.
RESEARCHER_USER_IDS=
# 커리큘럼 LLM 모드를 쓸 수 있는 사용자 UUID (쉼표 구분). LLM 키·모델은 ai/.env에 둔다.
CURRICULUM_LLM_USER_IDS=
