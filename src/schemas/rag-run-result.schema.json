{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wallet-core.local/schemas/rag-run-result.schema.json",
  "title": "RagRunResult",
  "type": "object",
  "required": ["run_id", "query_id", "condition", "model", "retrieved_contexts", "generated_answer", "generated_at"],
  "properties": {
    "run_id": { "type": "string" },
    "query_id": { "type": "string" },
    "condition": { "type": "string", "enum": ["A_no_rag", "B_naive_rag", "C_verified_rag"] },
    "model": {
      "type": "object",
      "required": ["name", "version_or_quant", "temperature"],
      "properties": {
        "name": { "type": "string" },
        "version_or_quant": { "type": "string" },
        "temperature": { "type": "number" },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "retrieved_contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": { "type": ["string", "null"] },
          "snippet": { "type": "string" },
          "verification_status": { "type": ["string", "null"] }
        }
      }
    },
    "generated_answer": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
